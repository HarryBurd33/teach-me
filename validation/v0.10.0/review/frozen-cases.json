{
  "version": 1,
  "cases": [
    {
      "id": "test_01_independent_node_chain_metadata_and",
      "input_and_expected": "def test_01_independent_node_chain_metadata_and(self):\n        self.independent();self.planning();self.assertEqual(self.plan_data()['conflicts'],[]);self.choices([]);before=self.snapshot();self.applying();actual=self.final_graph();self.assertEqual(actual['nodes'][0],self.l['patch']['upsert_nodes'][0]);self.assertEqual(actual['chains'][0]['premises'],['a','b']);self.assertEqual(actual['chains'][0]['conclusion'],'d');self.assert_sources(before)"
    },
    {
      "id": "test_02_identical_edits_automatic",
      "input_and_expected": "def test_02_identical_edits_automatic(self):\n        change=self.edit('a',name='Same claim');self.l['patch']['upsert_nodes']=[change];self.r['patch']['upsert_nodes']=[copy.deepcopy(change)];self.save_drafts();self.planning();self.assertEqual(self.plan_data()['conflicts'],[]);self.choices([]);self.applying();self.assertEqual(self.final_graph()['nodes'][0],change)"
    },
    {
      "id": "test_03_plan_deterministic_exact_schema",
      "input_and_expected": "def test_03_plan_deterministic_exact_schema(self):\n        self.independent();self.planning();raw=self.plan.read_bytes();p=self.plan_data();self.assertEqual(set(p),{'version','format','base_sha256','left_sha256','right_sha256','automatic','conflicts','notice'});self.assertEqual(p['format'],'teach-me-draft-merge-plan-v1');self.assertEqual(set(p['automatic']),{'nodes','chains'});self.assertEqual(p['left_sha256'],sha(self.left.read_bytes()));self.assertEqual(p['right_sha256'],sha(self.right.read_bytes()));self.assertNotIn(str(self.root),self.plan.read_text());self.plan=self.root/'again.json';self.planning();self.assertEqual(self.plan.read_bytes(),raw)"
    },
    {
      "id": "test_04_divergent_full_conflict_preview",
      "input_and_expected": "def test_04_divergent_full_conflict_preview(self):\n        self.conflict_setup();c=self.plan_data()['conflicts'][0];self.assertEqual(set(c),{'kind','id','reason','base','left','right'});self.assertEqual((c['kind'],c['id'],c['reason']),('node','a','both-edited'));self.assertEqual(c['base'],self.g['nodes'][0]);self.assertEqual(c['left'],self.l['patch']['upsert_nodes'][0]);self.assertEqual(c['right'],self.r['patch']['upsert_nodes'][0])"
    },
    {
      "id": "test_05_explicit_left",
      "input_and_expected": "def test_05_explicit_left(self):\n        self.conflict_setup();self.applying();self.assertEqual(self.final_graph()['nodes'][0]['statement'],'Left assertion')"
    },
    {
