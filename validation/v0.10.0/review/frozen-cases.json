    },
    {
      "id": "test_08_delete_edit_and_absent_choice",
      "input_and_expected": "def test_08_delete_edit_and_absent_choice(self):\n        self.l['patch']['delete_nodes']=['d'];self.r['patch']['upsert_nodes']=[self.edit('d',statement='Changed D')];self.save_drafts();self.planning();self.choices();self.assertEqual(self.plan_data()['conflicts'][0]['left'],None);self.applying();self.assertNotIn('d',[n['id'] for n in self.final_graph()['nodes']])"
    },
    {
      "id": "test_09_new_id_divergence_base_drops",
      "input_and_expected": "def test_09_new_id_divergence_base_drops(self):\n        self.l['patch']['upsert_nodes']=[dict(node('new'),statement='Left new')];self.r['patch']['upsert_nodes']=[dict(node('new'),statement='Right new')];self.save_drafts();self.planning();self.choices([{'kind':'node','id':'new','choose':'base'}]);self.applying();self.assertNotIn('new',[n['id'] for n in self.final_graph()['nodes']])"
    },
    {
      "id": "test_10_dependency_promotes_node_and_chain",
      "input_and_expected": "def test_10_dependency_promotes_node_and_chain(self):\n        self.l['patch']['delete_nodes']=['d'];self.r['patch']['upsert_chains']=[chain('uses-d',['a','d'],'c')];self.save_drafts();self.planning();cs=self.plan_data()['conflicts'];self.assertTrue({('node','d'),('chain','uses-d')} <= {(c['kind'],c['id']) for c in cs});self.assertTrue(all(c['reason']=='dependency' for c in cs));self.choices([{'kind':c['kind'],'id':c['id'],'choose':'right'} for c in cs]);self.applying();self.assertEqual(len(self.final_graph()['chains']),2)"
    },
    {
      "id": "test_11_invalid_dependency_choice_refused",
      "input_and_expected": "def test_11_invalid_dependency_choice_refused(self):\n        self.l['patch']['delete_nodes']=['d'];self.r['patch']['upsert_chains']=[chain('uses-d',['d'],'c')];self.save_drafts();self.planning();self.choices([{'kind':c['kind'],'id':c['id'],'choose':'left' if c['kind']=='node' else 'right'} for c in self.plan_data()['conflicts']]);before=self.snapshot();self.applying(ok=False);self.assertFalse(self.out.exists());self.assert_sources(before)"
    },
    {
      "id": "test_12_capacity_promotes_changes",
      "input_and_expected": "def test_12_capacity_promotes_changes(self):\n        self.g['nodes']=[node('n'+str(i)) for i in range(255)];self.g['chains']=[];self.write(self.base,self.g);self.l=self.draft();self.r=self.draft();self.l['patch']['upsert_nodes']=[node('left-new')];self.r['patch']['upsert_nodes']=[node('right-new')];self.save_drafts();self.planning();cs=self.plan_data()['conflicts'];self.assertTrue({'left-new','right-new'} <= {c['id'] for c in cs if c['kind']=='node'});self.assertTrue(all(c['reason']=='capacity' for c in cs));self.choices([{'kind':c['kind'],'id':c['id'],'choose':'base'} for c in cs]);self.applying();self.assertEqual(len(self.final_graph()['nodes']),255)"
    },
