      "id": "test_36_symlink_sensitive_traversal_refused",
      "input_and_expected": "def test_36_symlink_sensitive_traversal_refused(self):\n        link=self.root/'linked.json';link.symlink_to(self.base);self.base=link;self.planning(ok=False)\n        self.base=self.root/'base.json';self.left=self.root/'auth.json';self.write(self.left,self.l);self.planning(ok=False)\n        self.left=self.root/'left.json';self.base=self.root/'..'/self.root.name/'base.json';self.planning(ok=False)"
    },
    {
      "id": "test_37_duplicate_logical_arguments_composed_refused",
      "input_and_expected": "def test_37_duplicate_logical_arguments_composed_refused(self):\n        self.l['patch']['upsert_chains']=[chain('new-left',['a','b'],'d')];self.r['patch']['upsert_chains']=[chain('new-right',['b','a'],'d')];self.save_drafts();self.planning();self.choices();self.applying(ok=False);self.assertFalse(self.out.exists())"
    },
    {
      "id": "test_38_all_five_sources_rechecked",
      "input_and_expected": "def test_38_all_five_sources_rechecked(self):\n        self.planning();self.choices([]);m=self.module();original=m.data.tempfile.mkstemp\n        for target in [self.base,self.left,self.right,self.plan,self.decisions]:\n            raw=target.read_bytes()\n            def changed(*args,**kwargs):\n                value=original(*args,**kwargs);target.write_bytes(raw+b' ');return value\n            with patch.object(m.data.tempfile,'mkstemp',changed):self.assertNotEqual(m.main(self.apply_args()),0)\n            target.write_bytes(raw);self.assertFalse(self.out.exists())"
    },
    {
      "id": "test_39_foreign_destination_race_preserved",
      "input_and_expected": "def test_39_foreign_destination_race_preserved(self):\n        self.planning();self.choices([]);m=self.module()\n        def race(staged,destination):Path(destination).write_bytes(b'FOREIGN RACE');raise FileExistsError('other writer')\n        with patch.object(m.data.os,'link',race):self.assertNotEqual(m.main(self.apply_args()),0)\n        self.assertEqual(self.out.read_bytes(),b'FOREIGN RACE')"
    },
    {
      "id": "test_40_publication_io_failure_no_output",
      "input_and_expected": "def test_40_publication_io_failure_no_output(self):\n        self.planning();self.choices([]);m=self.module();before=self.snapshot()\n        with patch.object(m.data.os,'fsync',side_effect=OSError('injected storage failure')):self.assertNotEqual(m.main(self.apply_args()),0)\n        self.assertFalse(self.out.exists());self.assert_sources(before)"
    }
