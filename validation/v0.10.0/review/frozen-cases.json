      "id": "test_35_existing_outputs_preserved",
      "input_and_expected": "def test_35_existing_outputs_preserved(self):\n        self.plan.write_bytes(b'FOREIGN PLAN');self.planning(ok=False);self.assertEqual(self.plan.read_bytes(),b'FOREIGN PLAN');self.plan.unlink();self.planning();self.choices([]);self.out.write_bytes(b'FOREIGN DRAFT');self.applying(ok=False);self.assertEqual(self.out.read_bytes(),b'FOREIGN DRAFT')"
