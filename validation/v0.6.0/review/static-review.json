  "findings": [],
  "observations": [
    "History append takes store lock before journey lock, verifies current file manifest and packet SHA, rechecks receipt and content before atomic create-new link.",
    "History reads strict UTF-8 and closed receipt/entry schemas; validates canonical base64, exactint version and sequence, content digests and full chain. Old receipt freshness explicitly false.",
    "History bounds stat before read through coherence_review.read_regular, 64 entries, 3MiB per entry/stage, 64MiB accumulated bytes and 192 directory entries; receipt decode max2MiB.",
    "History outputs create-new outside store; orphan stages preserved/reported, append refuses them; shared lock ownership avoids stealing/replacement-lock removal.",
    "Maintenance uses unchanged versions/read_store/archive/lock utilities, fingerprints raw HEAD bytes and every revision bytehash; independent map-hash calculation matched.",
    "Maintenance plan protects current/previous, validates selection and closed exact current plan; apply holds store then archive locks and disallows archive roots in either ancestry direction.",
    "Maintenance stages byte copies, validates all archives and manifest, rechecks store, exclusively mkdir-reserves target, create-new hardlinks staging copies with manifest last, verifies target before any source unlink.",
    "Archive publication is completion-marker semantics, not atomic directory rename. Failure can leave incomplete target plus stage before deletion; docs accurately state this.",
    "Each unlink rechecks raw HEAD and selected archive hash. No backup-removal failure path. Partial unlink leaves complete archive and retained stages; old-plan replay not supported.",
    "No prior helper scripts, progress schema or transfer allowlist changed. Teaching activation, resource uncertainty, self-report distinction and physical-skill boundaries remain unchanged."
  ],
  "limits": [
    "One bounded independent source/docs review pass; no authenticated identity, semantic correctness, learner mastery or causal learner efficacy established.",
    "Cooperative locks and trusted local filesystem only; no hostile filesystem, universal interruption or power-loss guarantee.",
    "Directory/aggregate/count limits inspected statically; per-receipt/per-entry byte limits executed; exhaustive64-entry/64MiB/192-entry runtime boundary construction not performed.",
    "Existing full178 regressions, CI jobs, installed global copy, native discovery, tag/release downloads and artifact adoption are parent-owned checks; no independent claim here."
  ]
}
